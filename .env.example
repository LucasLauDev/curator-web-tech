# Copy to .env at project root before npm start, or run:
#   first-setup.bat — installs deps if needed, prompts for DATABASE_URL if missing, auto session secret, migrate + full seed, then npm start
#   npm run setup:db:new
# Non-interactive flags: node scripts/setup-new-database.js --migrate --seed

# Postgres (Project Settings → Database → connection string / URI).
# npm start verifies logins via public.users using this URL (pg Pool).
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# Signing key for portal_session cookie (HMAC SHA-256). Prefer ≥16 random characters.
PORTAL_SESSION_SECRET=change-me-at-least-16-chars

# Optional fallback name for the same secret
# SESSION_SECRET=

PORT=3000

# One-shot schema + demo data:
#   npm run setup:db
# Runs migrations from supabase/migrations/, then seed-users + bookstore catalog JSON + demo purchases.

# Inspect pending migrations without applying:
#   npm run migrate:dry-run
# If the DB already matches repo migrations, baseline only:
#   node scripts/migrate-db.js --baseline

# Regenerate supabase/seed-data/bookstore-catalog.json from current DB rows (requires existing data):
#   node scripts/export-bookstore-catalog-json.js > supabase/seed-data/bookstore-catalog.json

# Plain password used by npm run seed-users for demo portal rows (defaults to 123456)
# SEED_USER_PASSWORD=123456
